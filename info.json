{
    "schemaVersion": 1,
    "key": "minecraft-casual",
    "name": "Minecraft Casual",
    "desc": "我的世界原版风格的轻量休闲服务器",
    "registries": {
        "ghcr": "ghcr.io/hm-gamesrv/",
        "aliyun": "crpi-i9e7zrpnu4792a5m.cn-chengdu.personal.cr.aliyuncs.com/hiromuraki/"
    },
    "resources": {
        "ports": [
            {
                "host": "25565",
                "container": "25565",
                "proto": "tcp",
                "required": true,
                "desc": "游戏联机端口"
            },
            {
                "host": "25575",
                "container": "25575",
                "proto": "tcp",
                "desc": "RCON 端口"
            },
            {
                "host": "24454",
                "container": "24454",
                "proto": "udp",
                "desc": "模组“简单的语音聊天”所用端口"
            }
        ],
        "volumes": [
            {
                "host": "./minecraft-casual-world",
                "container": "/app/world",
                "required": true,
                "desc": "游戏世界存档"
            }
        ],
        "env": [
            {
                "name": "JAVA_MEMORY",
                "value": "4G",
                "secret": false,
                "desc": "JVM 堆内存大小（同时作用于 -Xms/-Xmx），如 4G、2500M"
            },
            {
                "name": "GAME_MAX_PLAYERS",
                "value": "8",
                "secret": false,
                "desc": "服务器列表显示的玩家容量，达到上限后新玩家无法加入"
            },
            {
                "name": "GAME_ONLINE_MODE",
                "value": "true",
                "secret": false,
                "desc": "是否启用在线验证模式：true=开启，false=关闭"
            },
            {
                "name": "GAME_AUTHLIB_INJECTOR_URL",
                "value": "https://mcskin.dsrv.top/api/yggdrasil",
                "secret": false,
                "desc": "外置登录（authlib-injector）Yggdrasil API 地址，置空则跳过外置登录"
            },
            {
                "name": "GAME_MANAGEMENT_SERVER_SECRET",
                "value": "",
                "secret": true,
                "desc": "Minecraft 管理服务器（management server）鉴权令牌"
            }
        ],
        "extraArgs": ""
    },
    "variants": [
        {
            "key": "26.2",
            "name": "26.2",
            "tag": "26.2",
            "container": "minecraft-casual-server"
        },
        {
            "key": "1.21.1",
            "name": "1.21.1",
            "tag": "1.21.1",
            "container": "minecraft-casual-1.21.1-server",
            "resources": {
                "ports": [
                    {
                        "host": "25565",
                        "container": "25565",
                        "proto": "tcp",
                        "required": true,
                        "desc": "游戏联机端口"
                    },
                    {
                        "host": "25575",
                        "container": "25575",
                        "proto": "tcp",
                        "desc": "RCON 端口"
                    }
                ],
                "volumes": [
                    {
                        "host": "./minecraft-casual-1.21.1-world",
                        "container": "/app/world",
                        "required": true,
                        "desc": "游戏世界存档"
                    },
                    {
                        "host": "./minecraft-casual-1.21.1-simple_backup",
                        "container": "/app/simple_backup",
                        "required": true,
                        "desc": "simple_backup 模组备份路径"
                    }
                ],
                "env": []
            }
        }
    ]
}